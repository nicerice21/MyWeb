---
import { SITE } from '../config';
import LinkButton from './LinkButton.astro';
---

<section class="hero">
  <div class="hero-inner">
    <p class="hero-kicker mono">STUDENT ENGINEER — PORTFOLIO 2026</p>
    <h1 class="hero-title">「オモシロイ」を形に</h1>
    <p class="hero-en">GEOMETRY · NOTEBOOK · GRADIENT</p>
    <div class="hero-links">
      <LinkButton href="/projects" variant="button">Projects を見る</LinkButton>
      <LinkButton href="/about">経歴とスキル ↗</LinkButton>
    </div>
  </div>
  <div class="hero-geo">
    <img class="hero-mark" src="/favicon.png" alt={`${SITE.enName} のマーク`} />
  </div>
</section>

<style>
  .hero {
    display: flex;
    gap: 32px;
    padding: 64px 0 72px;
  }

  .hero-inner {
    flex: 1;
    position: relative;
    z-index: 1;
    border-left: 1px solid rgba(222, 142, 136, 0.55);
    padding-left: 30px;
  }

  .hero-kicker {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    color: var(--ink-3);
    margin-bottom: 22px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hero-kicker::before {
    content: "";
    width: 26px;
    height: 1px;
    background: var(--ink-3);
  }

  .hero-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.9rem, 4.4vw, 2.9rem);
    line-height: 1.42;
    letter-spacing: 0.02em;
  }

  .hero-en {
    font-family: var(--disp);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.26em;
    color: var(--ink-3);
    margin-top: 20px;
  }

  .hero-links {
    display: flex;
    align-items: center;
    gap: 26px;
    margin-top: 34px;
  }

  .hero-geo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-mark {
    width: 240px;
    height: auto;
    display: block;
  }

  @media (max-width: 860px) {
    .hero {
      flex-direction: column;
    }

    .hero-geo {
      width: 100%;
    }

    .hero-mark {
      width: 160px;
    }
  }
</style>
