---
interface Props {
  title: string;
  index: string;
  year: string;
  summary: string;
  tags: string[];
  isHover?: boolean;
}

const { title, index, year, summary, tags, isHover = false } = Astro.props;
---

<article class:list={['card', 'reveal', { 'is-hover': isHover }]}>
  <div class="card-top mono">
    <span>{index}</span>
    <span>{year}</span>
  </div>
  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{summary}</p>
  <ul class="chips mono">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
</article>

<style>
  .card {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.65);
    background: rgba(251, 250, 246, 0.62);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    box-shadow: 6px 6px 0 rgba(29, 28, 24, 0.05);
    padding: 18px 20px 16px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .card.is-hover {
    border: 1px solid transparent;
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 rgba(29, 28, 24, 0.08);
    background: linear-gradient(rgba(251, 250, 246, 0.86), rgba(251, 250, 246, 0.86)) padding-box,
      var(--grad-a) border-box;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    margin-bottom: 12px;
  }

  .card-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.02rem;
    margin-bottom: 8px;
  }

  .card-desc {
    font-family: var(--sans);
    font-size: 0.82rem;
    color: var(--ink-2);
    line-height: 1.95;
    margin-bottom: 14px;
  }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
  }

  .chips li {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    border: 1px solid var(--rule);
    padding: 2px 9px;
  }
</style>
