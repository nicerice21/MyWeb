---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="sec-head reveal">
  <h2 class="sec-title">{title}</h2>
</header>

<style>
  .sec-head {
    border-bottom: 1px solid var(--ink);
    padding-bottom: 10px;
    margin-bottom: 36px;
  }

  .sec-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.28rem;
  }
</style>
