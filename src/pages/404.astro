---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="404" description="Page not found">
  <div class="site">
    <Header />
    <main class="not-found">
      <div class="not-found-geo" aria-hidden="true">
        <div class="geo-ring"></div>
        <div class="geo-dot"></div>
      </div>
      <div class="not-found-content">
        <p class="not-found-num mono">404</p>
        <h1 class="not-found-title">このページは<br />存在しません</h1>
        <p class="not-found-lead">お探しのページは移動したか、削除された可能性があります。</p>
        <a href="/" class="link mono">TOP PAGE →</a>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .site {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 80px;
    padding: 72px 0;
  }

  .not-found-geo {
    position: relative;
    width: 200px;
    height: 200px;
    flex-shrink: 0;
  }

  .geo-ring {
    position: absolute;
    width: 148px;
    height: 148px;
    border-radius: 50%;
    border: 1px solid var(--rule);
    top: 26px;
    left: 26px;
  }

  .geo-dot {
    position: absolute;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--grad-a);
    top: 94px;
    left: 94px;
  }

  .not-found-content {
    flex: 1;
    border-left: 1px solid rgba(222, 142, 136, 0.55);
    padding-left: 30px;
  }

  .not-found-num {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    color: var(--ink-3);
    margin-bottom: 16px;
  }

  .not-found-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.8rem;
    line-height: 1.4;
    margin-bottom: 16px;
  }

  .not-found-lead {
    font-family: var(--sans);
    font-size: 0.92rem;
    color: var(--ink-2);
    line-height: 1.9;
    margin-bottom: 32px;
  }

  .link {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: var(--ink);
    text-decoration: none;
  }

  .link:hover {
    background-image: var(--grad-a);
    background-repeat: no-repeat;
    background-size: 100% 1.5px;
    background-position: 0 100%;
  }

  @media (max-width: 860px) {
    .not-found {
      flex-direction: column;
      gap: 48px;
    }

    .site {
      padding: 0 18px;
    }
  }
</style>
